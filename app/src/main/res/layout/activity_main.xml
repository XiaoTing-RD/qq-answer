<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/bg_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="false"
        android:flipInterval="12000"
        android:inAnimation="@anim/bg_fade_in"
        android:outAnimation="@anim/bg_fade_out">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_sakura_1" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_sakura_2" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_sakura_3" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_sakura_4" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_sakura_5" />
    </ViewFlipper>

    <com.ridevoice.qq.SakuraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="26dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableEndCompat="@drawable/ic_heart"
                android:drawablePadding="8dp"
                app:drawableTint="@color/brand"
                android:letterSpacing="0.02"
                android:shadowColor="#B3FFFFFF"
                android:shadowRadius="8"
                android:text="海参的唤醒"
                android:textColor="@color/brand_dark"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="只读林霏 · 语音回复 · 落樱模式"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_badge"
                android:drawablePadding="5dp"
                android:letterSpacing="0.16"
                app:drawableStartCompat="@drawable/ic_heart"
                app:drawableTint="@color/white"
                android:paddingStart="11dp"
                android:paddingTop="4dp"
                android:paddingEnd="11dp"
                android:paddingBottom="4dp"
                android:text="SAKURA RIDE"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RideVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:drawableStartCompat="@drawable/ic_heart"
                                android:drawablePadding="6dp"
                                app:drawableTint="@color/brand"
                                android:text="骑行模式"
                                android:textColor="@color/ink"
                                android:textSize="21sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/service_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="未运行"
                                android:textColor="@color/muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_active"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/switch_thumb"
                            app:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/card_stroke" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="只读对象"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edit_contact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="QQ 备注名，例如：林霏"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingVertical="8dp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted"
                            android:textSize="17sp" />

                        <Button
                            android:id="@+id/btn_save_contact"
                            style="@style/Widget.RideVoice.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="保存"
                            app:icon="@drawable/ic_heart"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconTint="@color/brand_dark" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_only_contact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:text="只处理这个人的消息"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />

                    <TextView
                        android:id="@+id/contact_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="名字必须和 QQ 通知标题里的备注/昵称完全一致；其他人的消息会被忽略。"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RideVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:drawableStartCompat="@drawable/ic_heart"
                        android:drawablePadding="6dp"
                        app:drawableTint="@color/brand"
                        android:text="声音与闹铃"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_preset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/brand"
                        android:spinnerMode="dropdown" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_test_voice"
                            style="@style/Widget.RideVoice.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="试听声音"
                            app:icon="@drawable/ic_heart"
                            app:iconGravity="textStart"
                            app:iconPadding="5dp"
                            app:iconTint="@color/white" />

                        <Button
                            android:id="@+id/btn_tts_settings"
                            style="@style/Widget.RideVoice.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="TTS 设置" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/card_stroke" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_music"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingVertical="6dp"
                        android:text="收到消息时播放本地音乐"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_pick_music"
                            style="@style/Widget.RideVoice.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="选择本地音乐" />

                        <Button
                            android:id="@+id/btn_test_music"
                            style="@style/Widget.RideVoice.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="试听闹铃" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/music_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="还没选择音乐"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="提醒音乐最多播放 6 秒，然后开始朗读消息。"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/card_stroke" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="识别引擎"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spinner_engine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/brand"
                        android:spinnerMode="dropdown" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/voice_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="语音识别：检测中…"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btn_test_asr"
                            style="@style/Widget.RideVoice.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="测一测"
                            app:icon="@drawable/ic_heart"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconTint="@color/brand_dark" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/asr_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="点「测试」说一句话，检查本机语音识别是否正常。"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/voice_last_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="最近错误：无"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/send_last_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="最近发送失败：无"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="自动模式：系统语音被手机拦截时，自动切到离线 Vosk。离线模型随 APK 打包，首次准备需要几秒；识别失败时也会写入「最近错误」。"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RideVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:drawableStartCompat="@drawable/ic_heart"
                        android:drawablePadding="6dp"
                        app:drawableTint="@color/brand"
                        android:text="权限与 QQ"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="通知使用权"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/listener_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="未授权"
                            android:textColor="@color/warn"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_listener"
                            style="@style/Widget.RideVoice.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设置" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="麦克风"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/mic_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="未授权"
                            android:textColor="@color/warn"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_mic"
                            style="@style/Widget.RideVoice.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设置" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="通知"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/notif_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="未授权"
                            android:textColor="@color/warn"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_notif"
                            style="@style/Widget.RideVoice.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设置" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="后台运行"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/battery_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="未授权"
                            android:textColor="@color/warn"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_battery"
                            style="@style/Widget.RideVoice.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设置" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/card_stroke" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_qq_state"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="未检测到 QQ"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_qq_notifications"
                            style="@style/Widget.RideVoice.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QQ 通知" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/qq_reply_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="QQ 直接回复：等待一条 QQ 消息后检测"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_groups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp"
                        android:text="朗读群消息（只匹配这个人）"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RideVoice.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:drawableStartCompat="@drawable/ic_heart"
                        android:drawablePadding="6dp"
                        app:drawableTint="@color/brand"
                        android:text="怎么用"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:text="连发多条会先存进消息栈，按「第几条/共几条」逐条播报。\n听完后有 4 秒：说「回」再慢慢说内容，或直接说内容；不说就下一条。\n手机复述后说「确认」才会发送。\n发送失败会说原因并保留内容，可重试或复制到 QQ。\n识别失败会自动切离线 Vosk，正常音量说就行。\n\n骑行安全：不要看屏幕；需要手动处理时先靠边停车。"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="落樱模式 · 只在你手机本地处理"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
